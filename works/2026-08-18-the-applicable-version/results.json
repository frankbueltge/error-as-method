    {
      "clause": "Encoding Stability",
      "applicable": [
        "2.0"
      ],
      "statement": "Once a character is encoded, it will not be moved or removed."
    },
    {
      "clause": "Name Stability",
      "applicable": [
        "2.0"
      ],
      "statement": "The Unicode Name property value for any non-reserved code point will not be changed. In particular, once a character is encoded, its name will not be changed."
    },
    {
      "clause": "Formal Name Alias Stability",
      "applicable": [
        "5.0"
      ],
      "statement": "Formal aliases, once assigned to a character, will not be changed or removed."
    },
    {
      "clause": "Named Character Sequence Stability",
      "applicable": [
        "5.0"
      ],
      "statement": "Named character sequences will not be changed or removed."
    },
    {
      "clause": "Name Uniqueness",
      "applicable": [
        "2.0"
      ],
      "statement": "The names of characters, formal aliases, and named character sequences are unique within a shared namespace."
    },
    {
      "clause": "Normalization Stability",
      "applicable": [
        "4.1",
        "3.1"
      ],
      "statement": "If a string contains only characters from a given version of Unicode, and it is put into a normalized form in accordance with that version of Unicode, then the results will be identical to the results of putting that string into a normalized form in accordance with any subsequent version of Unicode."
    },
    {
      "clause": "Identity Stability",
      "applicable": [
